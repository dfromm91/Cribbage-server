server {
  listen ${PORT};
  server_name _;
  root /usr/share/nginx/html;
  include /etc/nginx/mime.types;
  location / { try_files $uri $uri/ /index.html =404; }
  location /api/ { proxy_pass ${API_SCHEME}://${API_HOST}:${API_PORT}; proxy_http_version 1.1; proxy_ssl_server_name on; proxy_set_header Host ${API_HOST}; proxy_set_header X-Forwarded-Proto $scheme; proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; }
  location /health { access_log off; return 200 'healthy'; add_header Content-Type text/plain; }
}
